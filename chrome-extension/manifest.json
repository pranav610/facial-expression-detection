{
    "manifest_version": 3,
    "name": "Meet Extension - Facial Expression Detection",
    "version": "2.1.0",
    "description": "Store the facial expressions of the people in the meeting and create a report",
    "author": "Pranav Kulkarni",
    "icons": {
        "16": "icons/logo.png",
        "48": "icons/logo.png",
        "128": "icons/logo.png"
    },
    "permissions": ["notifications"],
    "content_scripts": [
        {
            "matches": ["*://meet.google.com/*"],
            "js": ["content.js","face-api.min.js"],
            "type": "module"
        }
    ],
    "web_accessible_resources": [
        {
          "resources": ["models/*"],
          "matches": ["<all_urls>"]
        }
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    }
}
